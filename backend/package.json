  "bugs": {
    "url": "https://github.com/JDPetrovich/Controll-Med-Api/issues"
  },
  "homepage": "https://github.com/JDPetrovich/Controll-Med-Api#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.99.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "env-paths": "^4.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.4",
    "dotenv": "^17.3.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}