{
  "name": "controll-med-api",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs --update-env",
    "pm2:dev": "pm2 start src/main.ts --name api-dev --interpreter tsx",
    "pm2:stop": "pm2 stop api",
    "pm2:restart": "npm run build && pm2 restart api --update-env",
    "pm2:delete": "pm2 delete api"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JDPetrovich/Controll-Med-Api.git"
  },
  "keywords": [],
